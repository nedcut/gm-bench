{
  "name": "gm-bench-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:replay": "python3 ../scripts/build_web_replay_bundle.py",
    "validate:data": "bun scripts/validate_results_data.ts",
    "validate:replay:node": "bun scripts/validate_replay_node.mjs",
    "validate:replay": "bun run prepare:replay && bun run validate:replay:node",
    "generate:replay": "python3 ../scripts/build_web_replay_bundle.py --write-fixture",
    "build": "bun run validate:data && bun run validate:replay && bun run validate:trajectories && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate:trajectories": "python3 ../scripts/build_trajectory_demo.py --check && bun test scripts/trajectoryData.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "pyodide": "314.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.1"
  }
}
